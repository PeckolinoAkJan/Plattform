<Window x:Class="VtcDesktopClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VtcDesktopClient"
        Title="VTC Hub Desktop Client" Width="1672" Height="941"
        MinWidth="1280" MinHeight="760" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="False" ResizeMode="CanResizeWithGrip"
        Background="#090C0F" FontFamily="Bahnschrift" Foreground="#F4F0E6"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown">
    <Window.Resources>
        <SolidColorBrush x:Key="Gold" Color="#D9A928"/>
        <SolidColorBrush x:Key="GoldSoft" Color="#F2CD67"/>
        <SolidColorBrush x:Key="GoldDim" Color="#5D481B"/>
        <SolidColorBrush x:Key="Panel" Color="#101419"/>
        <SolidColorBrush x:Key="Panel2" Color="#14191F"/>
        <SolidColorBrush x:Key="Muted" Color="#9BA0A8"/>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#D90E1217"/>
            <Setter Property="BorderBrush" Value="#594A391C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F2EEE5"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#9DA1A8"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>
        <Style x:Key="GoldButton" TargetType="Button">
            <Setter Property="Foreground" Value="#0A0C0E"/>
            <Setter Property="Background" Value="#D9A928"/>
            <Setter Property="BorderBrush" Value="#F2CD67"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="root" Property="Background" Value="#F2CD67"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="root" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="#AEB2B9"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="22,14"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="root" Background="{TemplateBinding Background}" CornerRadius="0">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="root" Property="Background" Value="#15130D"/><Setter Property="Foreground" Value="#F2CD67"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="38"/><Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="#12161B"/><Setter Property="Foreground" Value="#D7B752"/>
            <Setter Property="BorderBrush" Value="#4C4023"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Border Margin="8" CornerRadius="18" Background="#090C0F" BorderBrush="#52431F" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <!-- SIDEBAR -->
            <Border Grid.Column="0" Background="#D90C1014" BorderBrush="#40371F" BorderThickness="0,0,1,0" CornerRadius="18,0,0,18">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="140"/><RowDefinition Height="*"/><RowDefinition Height="290"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="24,16,24,0">
                            <Image x:Name="LogoImage" Stretch="Uniform" Visibility="Collapsed"/>
                            <Grid x:Name="LogoFallback">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Canvas Width="72" Height="58" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Path Fill="#C69220" Data="M2,17 L25,6 L34,13 L22,18 L34,23 L22,28 L34,35 L18,31 Z"/>
                                    <Path Fill="#E5B93F" Data="M70,17 L47,6 L38,13 L50,18 L38,23 L50,28 L38,35 L54,31 Z"/>
                                    <Path Fill="#F2CD67" Stroke="#8D6414" StrokeThickness="1" Data="M25,7 L47,7 L49,35 L36,51 L23,35 Z"/>
                                    <Path Fill="#17130B" Data="M29,13 L35,13 L35,37 L30,30 Z M37,13 L43,13 L42,30 L37,37 Z"/>
                                </Canvas>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="VTC HUB" FontWeight="Bold" FontSize="21" Foreground="#F2CD67"/>
                                    <TextBlock Text="TRUCKING NETWORK" FontSize="9" Foreground="#8F939A" Margin="1,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                        <Border Grid.Row="1" BorderBrush="#4E4125" BorderThickness="0,1,0,0"/>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,4,0,0">
                        <Button x:Name="DashboardNavButton" Tag="DASHBOARD" Click="NavigationButton_Click" Style="{StaticResource NavButton}" Background="#201B0F" Foreground="#F2CD67" BorderBrush="#D9A928" BorderThickness="3,0,0,0" Content="▣     DASHBOARD"/>
                        <Button x:Name="JobsNavButton" Tag="JOBS" Click="NavigationButton_Click" Style="{StaticResource NavButton}" Content="▤     JOBS"/>
                        <Button x:Name="VehiclesNavButton" Tag="VEHICLES" Click="NavigationButton_Click" Style="{StaticResource NavButton}" Content="▰     VEHICLES"/>
                        <Button x:Name="DriversNavButton" Tag="DRIVERS" Click="NavigationButton_Click" Style="{StaticResource NavButton}" Content="♙     DRIVERS"/>
                        <Button x:Name="ReportsNavButton" Tag="REPORTS" Click="NavigationButton_Click" Style="{StaticResource NavButton}" Content="▥     REPORTS"/>
                        <Button x:Name="AlertsNavButton" Tag="ALERTS" Click="NavigationButton_Click" Style="{StaticResource NavButton}" Content="△     ALERTS"/>
                        <Button x:Name="MessagesNavButton" Tag="MESSAGES" Click="NavigationButton_Click" Style="{StaticResource NavButton}" Content="✉     MESSAGES"/>
                        <Button x:Name="SettingsNavButton" Tag="SETTINGS" Click="NavigationButton_Click" Style="{StaticResource NavButton}" Content="⚙     SETTINGS"/>
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="20,8,20,20">
                        <Grid.RowDefinitions><RowDefinition Height="150"/><RowDefinition Height="50"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource Card}" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Width="54" Height="54" CornerRadius="27" Background="#252C34" BorderBrush="#8A7130" BorderThickness="1">
                                        <TextBlock Text="{Binding UserAvatar}" FontSize="21" FontWeight="Bold" Foreground="#F2CD67" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Driver" Style="{StaticResource Label}"/>
                                        <TextBlock Text="{Binding UserName}" Foreground="#F4F0E6" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="ID: VTC-LOCAL" Foreground="#777E87" FontSize="11"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Grid.Row="1" Margin="0,9,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="●" Foreground="#4ADE80" FontWeight="SemiBold" FontSize="12" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding UserStatus}" Foreground="#4ADE80" FontWeight="SemiBold" FontSize="12"/>
                                    </StackPanel>
                                    <TextBlock Text="●  Telemetry secured" Foreground="#777E87" FontSize="10" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Button Grid.Row="1" Style="{StaticResource GoldButton}" Margin="0,8,0,0" Content="INSTALL TELEMETRY PLUGIN" x:Name="InstallPluginButton" IsEnabled="{Binding IsPluginActionEnabled}" Click="InstallPluginButton_Click"/>
                        <Button x:Name="SessionButton" Grid.Row="2" Margin="0,12,0,0" Height="46" Style="{StaticResource NavButton}" BorderBrush="#3B3F44" BorderThickness="1" Content="LOG IN                                      →" Click="SessionButton_Click"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- MAIN -->
            <Grid Grid.Column="1" Margin="28,14,20,14">
                <Grid.RowDefinitions><RowDefinition Height="65"/><RowDefinition Height="*"/><RowDefinition Height="48"/></Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#1D190E" BorderBrush="#6B5520" BorderThickness="1" CornerRadius="18" Padding="16,8">
                            <TextBlock Text="((•))  LIVE" Foreground="#F2CD67" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock Text="•  Last updated from SCS telemetry" Foreground="#8D9299" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        <Border x:Name="GameStatusCard" Background="Transparent" Margin="22,0,0,0" Padding="8,5">
                            <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{Binding GameStatusDotBrush}" Margin="0,0,7,0"/><TextBlock Text="{Binding GameStatus}" Foreground="#B2B6BC" FontSize="11"/></StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="ApiStatusCard" Background="Transparent" Padding="8,5" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{Binding ServerStatusDotBrush}" Margin="0,0,7,0"/><TextBlock Text="{Binding ApiStatus}" Foreground="#B2B6BC" FontSize="11"/></StackPanel>
                        </Border>
                        <TextBlock Text="☁  22°C" FontSize="14" Foreground="#E8E4DA" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <Button x:Name="CheckForUpdateButton" Style="{StaticResource GoldButton}" Content="{Binding UpdateActionLabel}" IsEnabled="{Binding IsUpdateActionEnabled}" Click="UpdateButton_Click" Margin="0,0,12,0"/>
                        <Button Style="{StaticResource WindowButton}" Content="—" Click="MinimizeButton_Click" Margin="0,0,8,0"/>
                        <Button x:Name="MaximizeButton" Style="{StaticResource WindowButton}" Content="□" Click="MaximizeButton_Click" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource WindowButton}" Content="×" Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="DashboardPanel" Grid.Row="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.72*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Margin="0,0,12,0">
                        <Grid.RowDefinitions><RowDefinition Height="1.9*"/><RowDefinition Height="0.9*"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock Text="SPEED" Style="{StaticResource SectionTitle}"/>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="185"/><ColumnDefinition Width="*"/><ColumnDefinition Width="185"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="◴   AVG SPEED" Style="{StaticResource Label}"/><TextBlock Text="{Binding AverageSpeed, StringFormat={}{0} KM/H}" FontSize="20" Margin="48,5,0,0"/></StackPanel></Border>
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="▰   TOTAL DISTANCE" Style="{StaticResource Label}"/><TextBlock Text="{Binding DistanceKm, StringFormat={}{0:F1} KM}" FontSize="20" Margin="48,5,0,0"/></StackPanel></Border>
                                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="◷   DRIVE TIME" Style="{StaticResource Label}"/><TextBlock Text="{Binding DriveTime}" FontSize="20" Margin="48,5,0,0"/></StackPanel></Border>
                                    </StackPanel>

                                    <local:AnalogTruckGauge Grid.Column="1" Margin="12,0" Speed="{Binding CurrentSpeed}" Odometer="{Binding OdometerKm}" ToolTip="Analoges Lkw-Kombiinstrument · 0–140 km/h"/>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="▣   FUEL LEVEL" Style="{StaticResource Label}"/><TextBlock Text="{Binding FuelPercent, StringFormat={}{0:F0}%}" FontSize="20" Margin="48,5,0,0"/></StackPanel></Border>
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="⚙   ENGINE TEMP" Style="{StaticResource Label}"/><TextBlock Text="{Binding EngineTemperature, StringFormat={}{0:F0}°C}" FontSize="20" Margin="48,5,0,0"/></StackPanel></Border>
                                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="◎   AIR PRESSURE" Style="{StaticResource Label}"/><TextBlock Text="{Binding BrakeAirPressure, StringFormat={}{0:F0} PSI}" FontSize="20" Margin="48,5,0,0"/><TextBlock Text="ALL GOOD" Foreground="#4ADE80" Margin="48,3,0,0"/></StackPanel></Border>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.28*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,6,0">
                                <Grid><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <DockPanel><TextBlock Text="VEHICLE STATUS" Style="{StaticResource SectionTitle}"/><TextBlock Text="●  SYSTEMS MONITORED" Foreground="#4ADE80" HorizontalAlignment="Right" DockPanel.Dock="Right"/></DockPanel>
                                    <UniformGrid Grid.Row="1" Columns="5" Margin="0,15,0,0">
                                        <StackPanel HorizontalAlignment="Center"><TextBlock Text="⚙" Foreground="#D9A928" FontSize="30" HorizontalAlignment="Center"/><TextBlock Text="ENGINE" Style="{StaticResource Label}"/><TextBlock Text="Normal" Foreground="#4ADE80" HorizontalAlignment="Center"/></StackPanel>
                                        <StackPanel HorizontalAlignment="Center"><TextBlock Text="◉" Foreground="#D9A928" FontSize="30" HorizontalAlignment="Center"/><TextBlock Text="GEARBOX" Style="{StaticResource Label}"/><TextBlock Text="Normal" Foreground="#4ADE80" HorizontalAlignment="Center"/></StackPanel>
                                        <StackPanel HorizontalAlignment="Center"><TextBlock Text="⌁" Foreground="#D9A928" FontSize="30" HorizontalAlignment="Center"/><TextBlock Text="CHASSIS" Style="{StaticResource Label}"/><TextBlock Text="Normal" Foreground="#4ADE80" HorizontalAlignment="Center"/></StackPanel>
                                        <StackPanel HorizontalAlignment="Center"><TextBlock Text="⊗" Foreground="#D9A928" FontSize="30" HorizontalAlignment="Center"/><TextBlock Text="BRAKES" Style="{StaticResource Label}"/><TextBlock Text="Normal" Foreground="#4ADE80" HorizontalAlignment="Center"/></StackPanel>
                                        <StackPanel HorizontalAlignment="Center"><TextBlock Text="▣" Foreground="#D9A928" FontSize="30" HorizontalAlignment="Center"/><TextBlock Text="TOTAL" Style="{StaticResource Label}"/><TextBlock Text="{Binding DamagePercent, StringFormat={}{0:F1}%}" Foreground="#4ADE80" HorizontalAlignment="Center"/></StackPanel>
                                    </UniformGrid>
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,0,0">
                                <Grid><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <TextBlock Text="FUEL EFFICIENCY" Style="{StaticResource SectionTitle}"/>
                                    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Grid><Ellipse Stroke="#332B1A" StrokeThickness="16" Margin="18"/><Ellipse Stroke="#D9A928" StrokeThickness="9" Margin="25"/><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding FuelEfficiency, StringFormat={}{0:F1}}" FontSize="36" HorizontalAlignment="Center"/><TextBlock Text="L/100 KM" Style="{StaticResource Label}" HorizontalAlignment="Center"/></StackPanel></Grid>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="CURRENT" Style="{StaticResource Label}"/><TextBlock Text="{Binding FuelEfficiency, StringFormat={}{0:F1} L/100 KM}" FontSize="17" Margin="0,4,0,15"/><TextBlock Text="TRUCK" Style="{StaticResource Label}"/><TextBlock Text="{Binding CurrentTruck}" TextWrapping="Wrap" FontSize="14" Margin="0,4,0,0"/></StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid Grid.Column="1" Margin="12,0,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="1.25*"/><RowDefinition Height="0.72*"/><RowDefinition Height="1*"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/><RowDefinition Height="56"/></Grid.RowDefinitions>
                                <DockPanel LastChildFill="False"><TextBlock Text="CURRENT JOB" Style="{StaticResource SectionTitle}"/><Border DockPanel.Dock="Right" Background="#292314" CornerRadius="12" Padding="12,5"><TextBlock Text="IN PROGRESS" Foreground="#F2CD67" FontSize="11"/></Border></DockPanel>
                                <Grid Grid.Row="1" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel><Ellipse Width="12" Height="12" Stroke="#D9A928" StrokeThickness="3"/><Border Width="2" Height="52" Background="#77705B"/><Ellipse Width="12" Height="12" Stroke="#E8D18C" StrokeThickness="2"/></StackPanel>
                                    <StackPanel Grid.Column="1"><TextBlock Text="{Binding CurrentCargo}" Foreground="#F0B72E" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding SourceCity}" FontSize="15" Margin="0,16,0,0"/><TextBlock Text="SCS source location" Style="{StaticResource Label}"/><TextBlock Text="{Binding DestinationCity}" FontSize="15" Margin="0,20,0,0"/><TextBlock Text="SCS destination location" Style="{StaticResource Label}"/></StackPanel>
                                </Grid>
                                <UniformGrid Grid.Row="2" Columns="3" Margin="0,10,0,0">
                                    <StackPanel Margin="0,0,10,0"><TextBlock Text="DISTANCE" Style="{StaticResource Label}"/><TextBlock Text="{Binding DistanceKm, StringFormat={}{0:F0} KM}" FontSize="16"/></StackPanel>
                                    <StackPanel Margin="10,0"><TextBlock Text="TRUCK" Style="{StaticResource Label}"/><TextBlock Text="{Binding CurrentTruck}" TextTrimming="CharacterEllipsis" FontSize="14"/></StackPanel>
                                    <StackPanel Margin="14,0,0,0"><TextBlock Text="STATUS" Style="{StaticResource Label}"/><TextBlock Text="LIVE" Foreground="#F2CD67" FontSize="16"/></StackPanel>
                                </UniformGrid>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="0">
                            <Grid ClipToBounds="True">
                                <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#101820"/><GradientStop Color="#090E13" Offset="1"/></LinearGradientBrush></Grid.Background>
                                <Path Stroke="#332D1E" StrokeThickness="1" Data="M0,45 L500,60 M0,100 L500,85 M80,0 L100,220 M260,0 L240,220 M420,0 L390,220"/>
                                <Path Stroke="#D9A928" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 60,38 C 120,95 210,74 272,124 S 394,146 450,184"/>
                                <Ellipse Width="16" Height="16" Fill="#F2CD67" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="52,30,0,0"/>
                                <Ellipse Width="16" Height="16" Fill="#F2CD67" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,42,28"/>
                                <TextBlock Text="{Binding SourceCity}" Margin="72,28,0,0" VerticalAlignment="Top" FontSize="13"/>
                                <TextBlock Text="{Binding DestinationCity}" Margin="0,0,64,26" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="13"/>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Background="#D911151A" CornerRadius="8" Padding="10"><TextBlock Text="＋&#x0a;—" FontSize="20" TextAlignment="Center"/></Border>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource Card}">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <DockPanel LastChildFill="False"><TextBlock Text="RECENT ALERTS" Style="{StaticResource SectionTitle}"/><TextBlock Text="VIEW ALL" Foreground="#F2CD67" DockPanel.Dock="Right"/></DockPanel>
                                <StackPanel Grid.Row="1">
                                    <Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions><TextBlock Text="●" Foreground="{Binding PluginStatusDotBrush}" FontSize="23"/><StackPanel Grid.Column="1"><TextBlock Text="Telemetry plugin"/><TextBlock Text="{Binding PluginStatus}" Style="{StaticResource Label}" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="2" Text="NOW" Style="{StaticResource Label}" HorizontalAlignment="Right"/></Grid>
                                    <Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions><TextBlock Text="●" Foreground="#3B82F6" FontSize="23"/><StackPanel Grid.Column="1"><TextBlock Text="Client update"/><TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource Label}" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="2" Text="NOW" Style="{StaticResource Label}" HorizontalAlignment="Right"/></Grid>
                                    <Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions><TextBlock Text="◆" Foreground="#4ADE80" FontSize="20"/><StackPanel Grid.Column="1"><TextBlock Text="Secure API channel"/><TextBlock Text="HMAC-SHA256 + timestamp + nonce" Style="{StaticResource Label}"/></StackPanel><TextBlock Grid.Column="2" Text="ACTIVE" Style="{StaticResource Label}" HorizontalAlignment="Right"/></Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <Border x:Name="SectionPanel" Grid.Row="1" Visibility="Collapsed" Style="{StaticResource Card}" Padding="34">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="{Binding SelectedSectionTitle}" FontSize="34" FontWeight="Bold" Foreground="#F2CD67"/>
                        <TextBlock Grid.Row="1" Text="{Binding SelectedSectionDescription}" FontSize="15" Foreground="#9DA1A8" Margin="0,8,0,28"/>
                        <UniformGrid x:Name="SectionMetricsPanel" Grid.Row="2" Columns="3" Margin="0,20,0,20">
                            <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding SectionMetric1Label}" Style="{StaticResource Label}"/><TextBlock Text="{Binding SectionMetric1Value}" FontSize="22" Foreground="#F4F0E6" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Margin="5,0"><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding SectionMetric2Label}" Style="{StaticResource Label}"/><TextBlock Text="{Binding SectionMetric2Value}" FontSize="22" Foreground="#F4F0E6" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Margin="10,0,0,0"><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding SectionMetric3Label}" Style="{StaticResource Label}"/><TextBlock Text="{Binding SectionMetric3Value}" FontSize="22" Foreground="#F4F0E6" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Border>
                        </UniformGrid>
                        <Grid x:Name="MessagesPanel" Grid.Row="2" Visibility="Collapsed" Margin="0,4,0,18">
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Border Style="{StaticResource Card}" Padding="14">
                                <ListBox ItemsSource="{Binding ChatMessages}" Background="Transparent" BorderThickness="0" Foreground="#F4F0E6" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#11171C" BorderBrush="#30343A" BorderThickness="1" CornerRadius="10" Padding="13" Margin="0,0,0,9">
                                                <Grid>
                                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                    <DockPanel>
                                                        <TextBlock Text="{Binding Sender.DisplayName}" Foreground="#F2CD67" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Foreground="#747B83" FontSize="11" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
                                                    </DockPanel>
                                                    <TextBlock Grid.Row="1" Text="{Binding Body}" TextWrapping="Wrap" Foreground="#E8EAED" Margin="0,7,0,0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                            <TextBlock Grid.Row="1" Text="{Binding ChatStatus}" Foreground="#9DA1A8" FontSize="12" Margin="2,9,0,7"/>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="ChatInput" MaxLength="1000" MinHeight="42" VerticalContentAlignment="Center" Background="#0B1014" Foreground="#F4F0E6" BorderBrush="#3B4148" BorderThickness="1" Padding="12,7" ToolTip="Nachricht an deine Spedition"/>
                                <Button Grid.Column="1" Style="{StaticResource GoldButton}" Content="AKTUALISIEREN" Click="RefreshChatButton_Click" Margin="10,0"/>
                                <Button Grid.Column="2" Style="{StaticResource GoldButton}" Content="SENDEN" Click="SendChatButton_Click"/>
                            </Grid>
                        </Grid>
                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource GoldButton}" Content="REFRESH STATUS" Click="RefreshSectionButton_Click" Margin="0,0,12,0"/>
                            <Button Style="{StaticResource GoldButton}" Content="OPEN WEB PORTAL" Click="OpenWebPortalButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Margin="0,12,0,0" Background="#101419" BorderBrush="#30343A" BorderThickness="1" CornerRadius="13" Padding="18,0">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding GpsStatusDetails}"><TextBlock Text="GPS" Foreground="#8F959D"/><Ellipse Width="8" Height="8" Fill="{Binding GpsStatusDotBrush}" Margin="10,0,8,0"/><TextBlock Text="{Binding GpsStatusText}" Foreground="#C8CDD2"/></StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding NetworkStatusDetails}"><TextBlock Text="NETWORK" Foreground="#8F959D"/><Ellipse Width="8" Height="8" Fill="{Binding NetworkStatusDotBrush}" Margin="10,0,8,0"/><TextBlock Text="{Binding NetworkStatusText}" Foreground="#C8CDD2"/></StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding SyncStatusDetails}"><TextBlock Text="ELD" Foreground="#8F959D"/><Ellipse Width="8" Height="8" Fill="{Binding SyncStatusDotBrush}" Margin="10,0,8,0"/><TextBlock Text="{Binding SyncStatusText}" Foreground="#C8CDD2"/></StackPanel>
                        <TextBlock Grid.Column="3" Text="VTC Hub Desktop Client" Foreground="#737982" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="{Binding CurrentVersion}" Foreground="#D9A928" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
