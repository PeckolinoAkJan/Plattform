<Application x:Class="VtcDesktopClient.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="VtcDisplayFont">Segoe UI</FontFamily>
            <FontFamily x:Key="VtcBodyFont">Segoe UI</FontFamily>

            <SolidColorBrush x:Key="Ink950Brush" Color="#030304"/>
            <SolidColorBrush x:Key="Ink900Brush" Color="#07070B"/>
            <SolidColorBrush x:Key="Ink820Brush" Color="#0B0F16"/>
            <SolidColorBrush x:Key="Ink780Brush" Color="#141B24"/>
            <SolidColorBrush x:Key="Ink740Brush" Color="#1C2431"/>
            <SolidColorBrush x:Key="Ink700Brush" Color="#242B38"/>

            <SolidColorBrush x:Key="Gold500Brush" Color="#D4AF37"/>
            <SolidColorBrush x:Key="Gold400Brush" Color="#F0C74D"/>
            <SolidColorBrush x:Key="Gold500SoftBrush" Color="#E9C87A"/>
            <SolidColorBrush x:Key="GoldDimBrush" Color="#5A4518"/>

            <SolidColorBrush x:Key="TextBrightBrush" Color="#F4F1E9"/>
            <SolidColorBrush x:Key="TextMutedBrush" Color="#C5BA9F"/>
            <SolidColorBrush x:Key="DividerBrush" Color="#2D3440"/>

            <DropShadowEffect x:Key="SoftGlow" BlurRadius="40" Opacity="0.55" ShadowDepth="0" Color="#000000"/>
            <DropShadowEffect x:Key="NeonGlow" BlurRadius="28" Opacity="0.72" ShadowDepth="0" Color="#D4AF37"/>

            <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#080A0F" Offset="0"/>
                <GradientStop Color="#0E121A" Offset="0.52"/>
                <GradientStop Color="#171D2A" Offset="1"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="PanelStrokeBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#35240F" Offset="0"/>
                <GradientStop Color="#5C4315" Offset="0.55"/>
                <GradientStop Color="#D4AF37" Offset="1"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="DividerBrushGradient" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#00000000" Offset="0"/>
                <GradientStop Color="#5A4518" Offset="0.12"/>
                <GradientStop Color="#D4AF37" Offset="0.5"/>
                <GradientStop Color="#5A4518" Offset="0.88"/>
                <GradientStop Color="#00000000" Offset="1"/>
            </LinearGradientBrush>

            <Style x:Key="PremiumDivider" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource DividerBrushGradient}"/>
                <Setter Property="Height" Value="1"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
